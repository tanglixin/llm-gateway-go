# 复制为 deploy/.env 后按需修改；不填则使用 compose 里的默认值。

# PostgreSQL
POSTGRES_USER=llm
POSTGRES_PASSWORD=llm
POSTGRES_DB=llm
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# MinIO（控制台 http://127.0.0.1:9001）
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000

# Ollama
OLLAMA_PORT=11434
OLLAMA_MODEL=qwen2:0.5b

# 租户（当前单租户）
NOVA_TENANT=default
