# 复制为 deploy/.env 后按需修改；不填则使用 compose 里的默认值。

# PostgreSQL
POSTGRES_USER=llm
POSTGRES_PASSWORD=llm
POSTGRES_DB=llm
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# MinIO（控制台 http://127.0.0.1:9001）
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000

# Ollama
OLLAMA_PORT=11434
OLLAMA_MODEL=qwen2:0.5b

# 租户（当前单租户）
NOVA_TENANT=default

# AI 网关的 provider 列表（JSON）。不配则退化成单个 Ollama。
# 支持 kind=ollama 与 kind=openai（OpenAI 兼容端点）。
GATEWAY_PROVIDERS=[{"name":"本地 Ollama","kind":"ollama","baseUrl":"http://127.0.0.1:11434","model":"qwen2:0.5b","weight":100}]

# JWT 签名密钥（生产必须换掉）
JWT_SECRET=dev-only-change-me
